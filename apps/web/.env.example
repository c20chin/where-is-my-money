# -------------------------------------------------------
# SERVER-SIDE SECRETS — never prefix with NEXT_PUBLIC_
# These are never exposed to the browser bundle.
# -------------------------------------------------------

# Neon PostgreSQL connection string (get from Neon dashboard)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Base URL of the app — http://localhost:3000 for local dev,
# your Vercel production URL (e.g. https://wimm.vercel.app) for prod.
# On Vercel this can be set to https://$VERCEL_URL or the custom domain.
NEXTAUTH_URL=http://localhost:3000

# Random secret for signing Auth.js tokens — run: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# Google OAuth credentials (Google Cloud Console > APIs & Services > Credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
